---
// 从数据源获取最新的产品信息
let miniapp = {
  name: "极简邮箱",
  version: "1.0.0",
  releaseDate: "2026-10-22",
  features: ["纯净无广告", "极速收发", "多端同步"]
};
let app = {
  name: "极简邮箱 APP",
  androidUrl: "https://yourdomain.com/download/android.apk", // 这里可以以后改成从 json 读取
  iosUrl: "https://apps.apple.com/",
  harmonyUrl: "https://appgallery.huawei.com/"
};

try {
  const response = await fetch('https://raw.githubusercontent.com/wangjungithubnew/product-data/main/products.json');
  if (response.ok) {
    const data = await response.json();
    if (data.miniapp) miniapp = data.miniapp;
    // 如果你以后在 products.json 里配置了这三个链接，这里会自动覆盖
    if (data.app) {
      app.androidUrl = data.app.downloadUrl || app.androidUrl;
      app.iosUrl = data.app.iosUrl || app.iosUrl;
      app.harmonyUrl = data.app.harmonyUrl || app.harmonyUrl;
    }
  }
} catch (e) {
  console.log("数据拉取失败，使用默认展示");
}
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{miniapp.name} - 专注高效与纯净</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <style>
            body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        </style>
    </head>
    <body class="bg-slate-50 text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900 min-h-screen flex flex-col">
        
        <!-- 顶部导航 -->
        <nav class="w-full border-b border-slate-200 bg-white/80 backdrop-blur-md sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-xl">M</div>
                    <span class="font-bold text-xl tracking-tight text-slate-900">{miniapp.name}</span>
                </div>
                <div class="flex items-center gap-4">
                    <a href="#download" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition">下载</a>
                </div>
            </div>
        </nav>

        <!-- 首屏 Hero 区域 -->
        <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-20 md:py-32 flex flex-col items-center text-center">
            
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-6">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                </span>
                正式发布 v{miniapp.version}
            </div>

            <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 max-w-3xl leading-tight">
                让沟通回归<span class="text-indigo-600">极简与纯粹</span>
            </h1>
            
            <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl">
                为你打造的高效、无干扰的邮件体验。告别繁琐，专注于真正重要的信息。
            </p>

            <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a href="#download" class="inline-flex justify-center items-center px-8 py-4 text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-sm transition-all duration-200">
                    立即下载客户端
                </a>
                <a href="#download" class="inline-flex justify-center items-center px-8 py-4 text-base font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl shadow-sm transition-all duration-200">
                    扫码使用小程序
                </a>
            </div>

            <!-- 功能特性网格 -->
            <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-6 w-full text-left">
                {miniapp.features.map((feature, index) => (
                    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow duration-300">
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center text-2xl mb-6">
                            {['⚡️', '🛡️', '☁️'][index % 3]}
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">{feature}</h3>
                        <p class="text-slate-500 leading-relaxed">为您提供最稳定、最高效的使用体验，让每一次操作都得心应手。</p>
                    </div>
                ))}
            </div>

        </main>

        <!-- 全平台下载与分发区域 -->
        <section id="download" class="w-full bg-white border-t border-slate-200 py-24">
            <div class="max-w-6xl mx-auto px-6">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-slate-900 mb-4">全平台支持，无缝同步</h2>
                    <p class="text-slate-600">目前最新版本为 v{miniapp.version}，更新于 {miniapp.releaseDate}。选择你的设备开始使用。</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <!-- 安卓版下载 -->
                    <a href={app.androidUrl} class="flex flex-col items-center p-8 bg-slate-50 rounded-2xl border border-slate-200 hover:border-indigo-400 hover:shadow-lg transition-all group">
                        <svg class="w-12 h-12 text-slate-700 group-hover:text-indigo-600 mb-4 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993 0 .5511-.4483.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.2439 13.8533 7.8508 12 7.8508s-3.5902.3931-5.1367 1.0989L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3435-4.1021-2.6892-7.5743-6.1185-9.4396z"/></svg>
                        <span class="font-bold text-slate-900 mb-1">Android 版</span>
                        <span class="text-sm text-slate-500">下载 APK 安装包</span>
                    </a>

                    <!-- iOS 版下载 -->
                    <a href={app.iosUrl} class="flex flex-col items-center p-8 bg-slate-50 rounded-2xl border border-slate-200 hover:border-indigo-400 hover:shadow-lg transition-all group">
                        <svg class="w-12 h-12 text-slate-700 group-hover:text-indigo-600 mb-4 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                        <span class="font-bold text-slate-900 mb-1">iOS 版</span>
                        <span class="text-sm text-slate-500">前往 App Store</span>
                    </a>

                    <!-- 鸿蒙版下载 -->
                    <a href={app.harmonyUrl} class="flex flex-col items-center p-8 bg-slate-50 rounded-2xl border border-slate-200 hover:border-indigo-400 hover:shadow-lg transition-all group">
                        <svg class="w-12 h-12 text-slate-700 group-hover:text-indigo-600 mb-4 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
                        <span class="font-bold text-slate-900 mb-1">HarmonyOS</span>
                        <span class="text-sm text-slate-500">前往华为应用市场</span>
                    </a>
                </div>

                <!-- 小程序码区域 -->
                <div class="bg-slate-50 rounded-3xl p-8 md:p-12 border border-slate-200 flex flex-col md:flex-row items-center justify-between gap-8 max-w-4xl mx-auto">
                    <div class="flex-1 space-y-2 text-center md:text-left">
                        <h3 class="text-2xl font-bold text-slate-900">轻量体验，即开即用</h3>
                        <p class="text-slate-600">无需下载安装，微信扫码直接使用。</p>
                    </div>
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col items-center">
                        <div class="w-32 h-32 bg-slate-100 rounded-lg flex items-center justify-center border-2 border-dashed border-slate-300">
                            <span class="text-slate-400 text-sm text-center px-2">小程序码<br/>替换图片</span>
                        </div>
                        <p class="text-slate-600 font-medium mt-3 text-sm">微信扫码体验</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 底部版权 -->
        <footer class="w-full bg-white border-t border-slate-200 py-8 text-center text-slate-500 text-sm">
            <p>© {new Date().getFullYear()} {miniapp.name}. All rights reserved.</p>
        </footer>

    </body>
</html>
