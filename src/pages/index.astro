---
import fallbackData from '../data/products.json';
import '../styles/projects.css';
import '../styles/bright-theme.css';
let productData = fallbackData;
try {
  const response = await fetch('https://raw.githubusercontent.com/wangjungithubnew/product-data/main/products.json');
  if (response.ok) productData = { ...fallbackData, ...await response.json() };
} catch (error) {
  console.info('Using bundled product data while remote product-data is unavailable.');
}
const miniapp = { ...fallbackData.miniapp, ...productData.miniapp, name: '我爱签名', platform: fallbackData.miniapp.platform, status: 'available' };
const mobileTool = { ...fallbackData.mobileTool, ...productData.mobileTool };
const projects = [
  { no: '01', type: miniapp.platform, title: miniapp.name, name: miniapp.subtitle, desc: miniapp.description, tags: miniapp.features.join(' · '), tone: 'rose', href: miniapp.url || '#contact', visual: 'signature' },
  { no: '02', type: `${mobileTool.platforms.join(' · ')} · 开发中`, title: mobileTool.name, name: '移动端版本正在开发', desc: mobileTool.description, tags: '移动端 · UI 预览', tone: 'blue', href: '#mobile-tool', visual: 'mobile-tool' },
];
---
<html lang="zh-CN" data-language="zh"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="JJW 的个人作品集：我爱签名微信小程序与移动端工具助手。" /><title>JJW · Independent Maker</title><link rel="stylesheet" href="/theme.css" /><style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap');
:root{--paper:#f2f6f1;--ink:#20332b;--muted:#66766d;--line:#d5e0d7;--blue:#4f8b68;--max:1240px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Noto Sans SC','Manrope',system-ui,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}.mono{font-family:'DM Mono',monospace;letter-spacing:.06em;text-transform:uppercase;font-size:11px}.wrap{max-width:var(--max);margin:auto;padding:0 34px}.site-header{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:12px;font-weight:700}.mark{width:32px;height:32px;border:1px solid var(--blue);border-radius:9px;display:grid;place-items:center;font:12px 'DM Mono';color:var(--blue);transform:rotate(-6deg)}.brand small{display:block;color:var(--muted);font:10px 'DM Mono';letter-spacing:.1em;margin-top:2px}.nav{display:flex;gap:30px;align-items:center;color:var(--muted);font-size:13px}.nav a:hover{color:var(--blue)}.nav .pill{padding:11px 17px;border:1px solid var(--blue);border-radius:5px;color:var(--blue)}.hero{padding:90px 0 100px;display:grid;grid-template-columns:1.18fr .82fr;gap:8vw;align-items:center}.eyebrow{display:flex;align-items:center;gap:12px;color:var(--muted);margin-bottom:23px}.dot{width:8px;height:8px;border-radius:2px;background:var(--blue);box-shadow:0 0 0 5px #dcebe0}.hero h1{font-size:clamp(48px,6vw,78px);line-height:1.08;letter-spacing:-.055em;margin:0 0 24px;font-weight:700}.hero h1 em{font-style:normal;color:var(--blue)}.hero p{max-width:540px;color:#5e7065;font-size:16px;line-height:2;margin:0 0 30px}.actions{display:flex;gap:22px;align-items:center}.button{background:var(--ink);color:#f6faf5;border-radius:5px;padding:13px 20px;font-size:14px;font-weight:600}.text-link{font-size:13px;border-bottom:1px solid #98aa9c;padding-bottom:5px}.hero-art{aspect-ratio:1/1;position:relative;border:1px solid #c9d9cd;border-radius:24px 100px 24px 24px;display:grid;place-items:center;background:radial-gradient(ellipse at 62% 40%,#dcecdf 0%,#eaf1e8 42%,#f8faf6 72%);overflow:hidden}.hero-art:before{content:'';position:absolute;width:135%;height:1px;background:#a5baa9;transform:rotate(-34deg)}.hero-art:after{content:'';position:absolute;width:70%;height:70%;border:1px solid #b5c9ba;border-radius:50%;left:16%;top:14%;box-shadow:0 0 0 35px #dce9de88,0 0 0 70px #dce9de55}.art-core{z-index:1;background:var(--blue);color:white;width:104px;height:104px;border-radius:24px 50% 50%;display:grid;place-items:center;font:12px 'DM Mono';text-align:center;line-height:1.5;transform:rotate(8deg);box-shadow:0 14px 36px #4f8b6830}.art-label{position:absolute;bottom:23px;left:24px;color:#607569}.hero{position:relative}.hero:after{content:'LM / 26';position:absolute;bottom:20px;right:0;font:10px 'DM Mono';color:#829288}section{border:0;padding:68px 30px;margin:20px 0;background:#fff;border-radius:14px;box-shadow:0 8px 28px #243d2d08}.section-top{display:grid;grid-template-columns:.7fr 2fr;gap:30px;margin-bottom:44px}.section-top>.mono{color:var(--blue);padding-top:8px}.section-top h2{font-size:clamp(29px,3.2vw,43px);line-height:1.2;letter-spacing:-.045em;margin:0;max-width:650px}.section-top p{font-size:14px;line-height:1.9;color:var(--muted);max-width:440px;margin:15px 0 0}.platforms{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:20px}.platform{padding:18px 15px;min-height:105px;border:0;border-right:1px solid var(--line);background:#f7faf6;display:flex;flex-direction:column;justify-content:space-between;transition:.25s;text-align:left;color:inherit}.platform:last-child{border:0}.platform:hover,.platform.active{background:#e5f0e6;color:#315b41}.platform strong{font:600 16px 'Manrope','Noto Sans SC',sans-serif}.platform span{color:#809087;font:10px 'DM Mono'}.platform.active span{color:#597762}.platform-card{border:1px solid var(--line);border-radius:10px;min-height:260px;padding:26px;display:grid;grid-template-columns:1fr 1fr;background:#eef5ee}.platform-card h3{font-size:32px;letter-spacing:-.04em;margin:16px 0 13px}.platform-card p{color:var(--muted);line-height:1.9;max-width:330px;font-size:14px}.fake-screen{background:#fafff9;border:1px solid #ccdbce;border-radius:8px;padding:15px;position:relative;overflow:hidden}.fake-screen .window{height:100%;border:1px solid #d7e2d8;border-radius:5px;padding:16px;background:linear-gradient(135deg,transparent 0 49%,#eaf1eb 49% 50%,transparent 50%)}.screen-lines{display:grid;gap:9px;margin-top:18px}.screen-lines i{display:block;height:7px;background:#cbd9cd;width:75%;border-radius:5px}.screen-lines i:nth-child(2){width:54%}.screen-lines i:nth-child(3){width:85%}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.project{border:1px solid var(--line);border-radius:10px;padding:25px;min-height:270px;display:flex;flex-direction:column;justify-content:space-between;transition:.25s;background:#f8faf7}.project:hover{transform:translateY(-3px);border-color:#9fbaa5;background:#f0f6ef}.project-head{display:flex;justify-content:space-between;color:#7b8a80}.project h3{font:700 29px 'Manrope','Noto Sans SC',sans-serif;letter-spacing:-.04em;margin:19px 0 6px;color:var(--blue)}.project h4{font-weight:500;font-size:14px;margin:0 0 12px}.project p{color:var(--muted);line-height:1.85;font-size:13px;max-width:430px;margin:0}.project-foot{display:flex;justify-content:space-between;align-items:end;margin-top:30px}.project-foot span{font:10px 'DM Mono';color:#738279}.tone{height:8px;width:32px;border-radius:2px;transform:rotate(-35deg)}.rose{background:#e99b80}.blue{background:#7e9fe7}.lime{background:#91bd68}.violet{background:#a48cc7}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step{padding:20px;border:1px solid var(--line);border-radius:9px;background:#f8faf7;margin:0}.step h3{font-size:16px;margin:30px 0 9px}.step p{font-size:12px;color:var(--muted);line-height:1.8;margin:0}.step .num{display:flex;justify-content:space-between;color:var(--blue)}.contact{padding:72px 30px;background:#e4efe4}.contact h2{font-size:clamp(42px,6vw,76px);line-height:1.08;letter-spacing:-.055em;max-width:900px;margin:18px 0 30px}.contact h2 em{font-style:normal;color:var(--blue)}.contact-row{display:flex;justify-content:space-between;align-items:end;border-top:1px solid #c6d7c8;padding-top:20px}.contact-row p{color:#5e7065;line-height:1.9;margin:0;font-size:14px}.contact-links{display:flex;gap:24px;font-size:13px}.contact-links a:hover{color:var(--blue)}footer{border-top:1px solid var(--line);padding:23px 0 30px;color:#78877d;font-size:11px;display:flex;justify-content:space-between}.mobile-nav{display:none}@media(max-width:800px){.wrap{padding:0 20px}.site-header{height:70px}.nav{display:none}.mobile-nav{display:block;font-size:13px;color:var(--blue)}.hero{padding:66px 0 75px;display:block}.hero h1{font-size:52px}.hero-art{margin:45px auto 0;max-width:390px}.hero:after{display:none}section{padding:46px 19px;margin:14px 0;border-radius:11px}.section-top{display:block;margin-bottom:32px}.section-top h2{margin:15px 0 18px}.platforms{grid-template-columns:repeat(2,1fr)}.platform:nth-child(2n){border-right:0}.platform:nth-child(n+3){border-top:1px solid var(--line)}.platform-card{grid-template-columns:1fr;gap:20px;padding:20px}.platform-card h3{font-size:27px}.fake-screen{min-height:180px}.project-grid{grid-template-columns:1fr}.project{min-height:240px}.steps{grid-template-columns:1fr 1fr;gap:10px}.step{padding:16px}.step h3{margin-top:23px}.contact{padding:48px 19px}.contact h2{font-size:46px}.contact-row{display:block}.contact-links{margin-top:25px;flex-wrap:wrap;gap:16px}footer{display:block}footer span{display:block;margin-top:9px}}
.platform-strip{display:flex;gap:10px;flex-wrap:wrap;margin:-18px 0 24px}.platform-strip span{padding:8px 13px;border-radius:5px;background:#eaf2eb;color:#466d52;font-size:12px}.platform-note{margin-top:20px;padding:18px 20px;background:#f5f8f4;border-left:3px solid var(--blue);display:grid;gap:7px}.platform-note strong{font-size:14px}.platform-note span{font-size:12px;line-height:1.8;color:var(--muted)}.thinking-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.thinking-grid article{padding:22px;border-radius:9px;background:#f7faf6;border:1px solid var(--line)}.thinking-grid .mono{color:var(--blue)}.thinking-grid h3{font-size:19px;margin:24px 0 11px}.thinking-grid p{font-size:13px;color:var(--muted);line-height:1.9;margin:0}.project-visual{height:210px;margin:-25px -25px 22px;padding:20px 20px 0;overflow:hidden;border-radius:9px 9px 0 0;background:#e7f0e7;display:flex;justify-content:center;align-items:flex-end}.device{width:150px;height:190px;padding:9px 8px 0;border:4px solid #34453b;border-bottom:0;border-radius:23px 23px 0 0;background:#fbfdf9;box-shadow:0 8px 20px #1e362322;overflow:hidden}.device-bar{height:6px;width:44px;border-radius:9px;background:#405146;margin:0 auto 10px}.ui-title{font-size:10px;font-weight:700}.ui-sub{font-size:7px;color:#819087;margin-top:3px}.ui-tile{padding:8px;margin-top:8px;border-radius:7px;background:#eef5ee;font-size:8px}.ui-tile strong{display:block;font-size:9px;margin-bottom:3px}.ui-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #e5ece5;font-size:8px}.ui-value{font-size:18px;font-weight:700;margin:11px 0;color:#355d43}.project-visual.tools{background:#f4eadf}.project-visual.wallet{background:#e8eef8}.project-visual.journal{background:#f1eee5}.project-visual.code{background:#eceaf5}.project-visual.tools .device{height:182px}.project-visual.wallet .device{height:195px}.project-visual.journal .device{height:188px}.project-visual.code .device{width:230px;height:160px;border-radius:9px 9px 0 0;padding:13px;background:#202b27;color:#dce8dc}.code-lines{font:7px/1.8 'DM Mono',monospace;color:#b8d99f}.project{padding-top:25px}.project-visual+.project-body{min-height:205px}.project-body{display:flex;flex-direction:column;justify-content:space-between;flex:1}
</style></head><body><header class="site-header wrap"><a class="brand" href="#top"><span class="mark">JJW</span><span>JJW<small>INDEPENDENT MAKER</small></span></a><nav class="nav"><a href="#work" data-en="Projects">项目</a><a href="#thinking" data-en="Product notes">产品想法</a><a class="pill" href="#contact" data-en="Let's talk ↗">聊聊技术 ↗</a><button class="language-toggle" type="button" aria-label="Switch language">EN</button></nav><button class="language-toggle mobile-language" type="button" aria-label="Switch language">EN</button><a class="mobile-nav" href="#contact" data-en="Contact">联系 ↗</a></header><main id="top" class="wrap">
<section class="hero" style="border-top:0"><div><div class="eyebrow mono"><span class="dot"></span> INDEPENDENT MAKER · JJW</div><h1 data-en-html="Making useful<br/><em>things for people.</em>">做能被人<br/><em>真正用上</em>的产品。</h1><p data-en="I'm JJW, an independent maker building small apps and everyday tools. I care about the details that make technology feel clear, useful, and a little more human.">我是 JJW，独立开发者。平时做小程序、移动应用和开发工具。比起功能列表，我更在意一个产品能不能让真实的人少一点麻烦，也更放心地完成手头的事。</p><div class="actions"><a class="button" href="#projects" data-en="Explore projects ↗">看我的项目 ↗</a><a class="text-link" href="#thinking" data-en="Product notes ↓">聊聊产品与技术 ↓</a></div></div><div class="hero-art"><div class="art-core">IDEA<br/>INTO<br/>PRACTICE</div><span class="art-label mono">DESIGN · BUILD · LEARN</span></div></section>
<section id="work"><div class="section-top"><div class="mono">01 / PRODUCTS</div><div><h2 data-en-html="Things I've<br/>made and shipped.">我做的产品，<br/>已经在这里。</h2><p data-en="A finished WeChat signature mini program, plus a mobile companion currently in development.">一款已经可以体验的微信签名小程序，以及一个正在开发中的移动端工具助手。</p></div></div><div class="platform-strip"><span>{miniapp.platform}</span><span>iOS · Android · HarmonyOS</span></div><div class="project-grid" id="projects">{projects.map((project) => <a href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class={`project ${project.visual === 'mobile-tool' ? 'in-progress' : ''}`}><div class={`project-visual ${project.visual}`} aria-hidden="true"><div class="device">{project.visual === 'signature' ? <><span class="device-bar"></span><span class="signature-mark">签</span><span class="device-label" data-en="Sign here">手写签名</span><span class="tool-chip" data-en="Color　 Width　 Undo　 Rewrite">颜色　粗细　撤销　重写</span><span class="save-action" data-en="Save to photos">保存到相册</span></> : <><span class="device-bar"></span><span class="mobile-placeholder">{mobileTool.name}</span><span class="mobile-status">iOS　 Android　 HarmonyOS<br/><br/><span data-en="Mobile app in development">移动端版本开发中</span></span></>}</div></div><div class="project-body"><div><div class="project-head"><span class="mono" data-en={project.visual === 'signature' ? 'WeChat mini program' : 'iOS · Android · HarmonyOS · In development'}>{project.type}</span><span class="mono">{project.visual === 'mobile-tool' ? 'IN PROGRESS' : `${project.no} ↗`}</span></div><h3 data-en={project.visual === 'signature' ? 'I Love Signing' : 'Time Tools'}>{project.title}</h3><h4 data-en={project.visual === 'signature' ? 'A thoughtful place for your signature' : 'Mobile version in development'}>{project.name}</h4><p data-en={project.visual === 'signature' ? miniapp.descriptionEn : mobileTool.descriptionEn}>{project.desc}</p></div><div class="project-foot"><span data-en={project.visual === 'signature' ? miniapp.featuresEn.join(' · ') : 'Mobile app · Preview UI'}>{project.tags}</span><i class={`tone ${project.tone}`}></i></div></div></a>)}</div><div class="platform-note"><strong data-en="The mobile companion is in development.">移动端工具助手正在开发中。</strong><span data-en="iOS, Android, and HarmonyOS details will be updated as development progresses.">iOS、Android 与 HarmonyOS 版本的进度和功能，会在项目准备好后更新。</span></div></section>
<section id="thinking"><div class="section-top"><div class="mono">02 / PRODUCT NOTES</div><div><h2 data-en-html="A signature stays personal.<br/>The product should too.">签名留在本地，<br/>是一个有意的选择。</h2><p data-en="A signature is personal. This mini program keeps the act of writing simple and puts the finished image in your hands, ready to save to your photo album.">签名很个人，也常常重要。这个小程序把书写和保存交还给使用者：写好后保存到自己的相册，不需要先注册一个账号，也不必把签名交给陌生的服务。</p></div></div><div class="thinking-grid"><article><span class="mono">01 / DIRECT</span><h3 data-en="Open and write.">打开就能写。</h3><p data-en="The canvas comes first. Color, stroke width, undo, and rewrite are right where you need them.">把画布放在最显眼的位置，颜色、粗细和重写都在手边，不让用户先穿过一串设置页面。</p></article><article><span class="mono">02 / IN CONTROL</span><h3 data-en="Your signature, your choice.">保存由你决定。</h3><p data-en="When you're done, save the signature to your photos. No account setup stands between you and the result.">签名完成后由用户主动保存到相册。清楚知道文件去了哪里，比默认上传再解释更让人安心。</p></article><article><span class="mono">03 / STILL BUILDING</span><h3 data-en="A mobile companion is next.">下一步，认真做移动端。</h3><p data-en="The mobile companion is in development. First make the real workflow feel right, then make platform promises.">移动端工具助手还在开发中。先把真实使用流程和界面打磨好，再谈发布平台和功能承诺。</p></article></div></section>
<section id="contact" class="contact"><div class="mono">03 / SAY HELLO</div><h2 data-en-html="Good ideas start<br/>with a conversation.">技术之外，<br/>也想听听你的<em>想法。</em></h2><div class="contact-row"><p data-en="Building something of your own, or curious about a detail in these projects? I'd love to talk about product decisions, implementation, and ideas still taking shape.">如果你也在做产品，或者对这些项目里的某个细节有兴趣，<br/>欢迎来交流实现方式、产品判断，或一个还没想完的问题。</p><div class="contact-links"><a href="mailto:zfjobslib@vip.qq.com" data-en="Email ↗">发邮件 ↗</a><a href="https://zfj1128.blog.csdn.net" target="_blank" rel="noreferrer" data-en="Tech blog ↗">技术博客 ↗</a><a href="#top" data-en="Back to top ↑">回到开头 ↑</a></div></div></section></main><footer class="wrap"><span>© 2026 JJW · INDEPENDENT MAKER</span><span>Built with care, one release at a time.</span></footer><script>
const languageButtons=document.querySelectorAll('.language-toggle');
function setLanguage(language){const english=language==='en';document.documentElement.lang=english?'en':'zh-CN';document.documentElement.dataset.language=language;document.querySelectorAll('[data-en]').forEach(el=>{if(!el.dataset.zh)el.dataset.zh=el.textContent;el.textContent=english?el.dataset.en:el.dataset.zh;});document.querySelectorAll('[data-en-html]').forEach(el=>{if(!el.dataset.zhHtml)el.dataset.zhHtml=el.innerHTML;el.innerHTML=english?el.dataset.enHtml:el.dataset.zhHtml;});document.querySelectorAll('.language-toggle').forEach(button=>button.textContent=english?'中文':'EN');document.title=english?'JJW · Independent Maker':'JJW · 独立创作者';}
languageButtons.forEach(button=>button.addEventListener('click',()=>setLanguage(document.documentElement.dataset.language==='en'?'zh':'en')));
</script></body></html>
