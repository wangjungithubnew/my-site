---
// 去拉取你刚刚在 GitHub 上建好的数据文件
// ⚠️ 注意：请把下面 URL 里的 wangjungithubnew 换成你自己的 GitHub 用户名！
const response = await fetch('https://raw.githubusercontent.com/wangjungithubnew/product-data/main/products.json');
const data = await response.json();
const miniapp = data.miniapp;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<title>{miniapp.name}</title>
		<style>
			body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f7f6; text-align: center; padding-top: 80px; color: #333; }
			.card { background: white; width: 400px; margin: 0 auto; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
			h1 { margin-top: 0; color: #1a1a1a; }
			.version { background: #e0f2fe; color: #0284c7; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 0.9em; }
			ul { list-style-type: none; padding: 0; text-align: left; margin-top: 20px; }
			li { background: #f8fafc; margin-bottom: 8px; padding: 10px 15px; border-radius: 8px; border-left: 4px solid #38bdf8; }
			.date { color: #888; font-size: 0.85em; margin-top: 20px; }
		</style>
	</head>
	<body>
		<div class="card">
			<h1>{miniapp.name}</h1>
			<div class="version">v{miniapp.version}</div>
			
			<ul>
				{miniapp.features.map(feature => <li>✨ {feature}</li>)}
			</ul>

			<div class="date">发布于：{miniapp.releaseDate}</div>
		</div>
	</body>
</html>